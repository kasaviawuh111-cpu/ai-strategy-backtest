# Candidate only: the container refuses to start unless every production gate
# below is satisfied. Never put administrator credentials in this file.
DEPLOYMENT_PROFILE=strict_production
APP_ENV=production
INITIALIZE_SCHEMA=false
MARKET_DATA_PROFILE=on_demand_snapshot
ON_DEMAND_REFRESH_EACH_SUBMISSION=true

# Inject as a CloudBase secret. It must authenticate a dedicated PostgreSQL
# LOGIN role with no SUPERUSER/CREATEDB/CREATEROLE/REPLICATION/BYPASSRLS.
# A cloudbase_admin/cloudbase_postgres/service_role URL is forbidden.
DATABASE_URL=postgresql+psycopg://ashare_runtime:<platform-secret>@<private-host>:5432/<database>

# DATABASE_ADMIN_URL and RUNTIME_DATABASE_PASSWORD are operator-only inputs to
# production_db.py. Never add them to this runtime configuration or Cloud Run.

# The CloudBase Run candidate must be attached to the database VPC/subnet.
# A public or localhost database endpoint is not an accepted substitute.

# Mount a provider-backed persistent filesystem/object-store filesystem at this
# path before the process starts. The marker and restart probe must already
# exist after an instance restart; image paths and /tmp are rejected.
SNAPSHOT_STORAGE_MODE=durable_mount
SNAPSHOT_STORAGE_ID=replace-with-provider-storage-resource-id
SNAPSHOT_STORAGE_RESTART_PROBE_ID=replace-with-cross-restart-probe-id
SNAPSHOT_STORAGE_MARKER=/mnt/ashare-snapshots/.ashare-snapshot-store.json
CHOICE_SNAPSHOT_ROOT=/mnt/ashare-snapshots/choice
TECHNICAL_SNAPSHOT_ROOT=/mnt/ashare-snapshots/technical
EVENT_SNAPSHOT_ROOT=/mnt/ashare-snapshots/events
COMPOSITE_SNAPSHOT_ROOT=/mnt/ashare-snapshots/composite
SNAPSHOT_PREPARATION_ROOT=/mnt/ashare-snapshots/preparations

# Exact clean integration commit used for this build.
CODE_REVISION=replace-with-40-character-clean-git-sha

# The atomic image serves web/dist and /api from one origin, so CORS is empty.
# For a separate WorkBuddy UI, inject its exact restored HTTPS origin here at
# runtime. Never use "*", and do not guess from an old release URL.
CORS_ALLOWED_ORIGINS=
WEB_DIST_ROOT=/app/web/dist

# Backend-only model and current-data provider settings. Bind every *_API_KEY
# value to the platform secret manager at runtime. Never put these secrets in
# VITE_* variables, frontend source, frontend build args, or the built dist.
CANDIDATE_PROVIDER_MODE=openai_compatible
CANDIDATE_PROVIDER_NAME=deepseek
CANDIDATE_PROVIDER_ENDPOINT=https://api.deepseek.com/chat/completions
CANDIDATE_PROVIDER_MODEL=deepseek-v4-flash
CANDIDATE_PROVIDER_RESPONSE_MODE=json_object
CANDIDATE_PROVIDER_API_KEY=<platform-secret>
RESEARCH_PROVIDER_MODE=deepseek_responses
RESEARCH_PROVIDER_ENDPOINT=https://api.deepseek.com/responses
RESEARCH_PROVIDER_MODEL=deepseek-v4-flash
RESEARCH_PROVIDER_API_KEY=<platform-secret>
RESEARCH_PROVIDER_TIMEOUT_SECONDS=120
MX_SAAS_API_KEY=<platform-secret>

LOG_LEVEL=INFO
MAX_BODY_BYTES=16384
