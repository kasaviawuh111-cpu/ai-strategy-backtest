# Temporary candidate only. This profile is deliberately non-production.
DEPLOYMENT_PROFILE=ephemeral_candidate
APP_ENV=staging
INITIALIZE_SCHEMA=true
DATABASE_URL=sqlite+pysqlite:////app/var/ephemeral/ashare.db
QUEUE_BACKEND=thread
LOCAL_WORKER_THREADS=1

# These labels are release evidence. The API does not yet expose them as
# capability fields, and this candidate has no cross-restart recovery claim.
PERSISTENCE_MODE=ephemeral
RESTART_RECOVERY_VERIFIED=false
SNAPSHOT_STORAGE_MODE=ephemeral_local

MARKET_DATA_PROFILE=on_demand_snapshot
DATA_ROOT=/app/var/snapshots/composite/<seed-composite-digest>
SESSION_REFERENCE_MODE=parquet
SESSION_REFERENCE_PATH=/app/var/snapshots/composite/<seed-composite-digest>/instrument_sessions.parquet
CHOICE_SNAPSHOT_ROOT=/app/var/ephemeral/snapshots/choice
TECHNICAL_SNAPSHOT_ROOT=/app/var/ephemeral/snapshots/technical
EVENT_SNAPSHOT_ROOT=/app/var/ephemeral/snapshots/events
COMPOSITE_SNAPSHOT_ROOT=/app/var/ephemeral/snapshots/composite
SNAPSHOT_PREPARATION_ROOT=/app/var/ephemeral/snapshots/preparations

CODE_REVISION=replace-with-40-character-clean-git-sha
CORS_ALLOWED_ORIGINS=https://59ac3319a9594be59fa3034fcae82a8f.app.workbuddy.link

# Choice EmQuantAPI and its credentials are intentionally not included in the
# image. Without an operator-provided SDK session, Choice remains unavailable
# and the existing acquisition layer may use only its explicit public fallback.
