{
  "$defs": {
    "AllCondition": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Children",
          "type": "array"
        },
        "type": {
          "const": "all",
          "default": "all",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "title": "AllCondition",
      "type": "object"
    },
    "AnyCondition": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Children",
          "type": "array"
        },
        "type": {
          "const": "any",
          "default": "any",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "title": "AnyCondition",
      "type": "object"
    },
    "BacktestConfig": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "initial_cash_cny": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "title": "Initial Cash Cny",
          "type": "integer"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "initial_cash_cny"
      ],
      "title": "BacktestConfig",
      "type": "object"
    },
    "CatalogRef": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$",
          "title": "Catalog Id",
          "type": "string"
        },
        "release_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Release Version",
          "type": "string"
        }
      },
      "required": [
        "catalog_id",
        "release_version"
      ],
      "title": "CatalogRef",
      "type": "object"
    },
    "Condition": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllCondition",
          "any": "#/$defs/AnyCondition",
          "event_condition": "#/$defs/EventCondition",
          "financial_condition": "#/$defs/FinancialCondition",
          "indicator_condition": "#/$defs/IndicatorCondition",
          "not": "#/$defs/NotCondition"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/IndicatorCondition"
        },
        {
          "$ref": "#/$defs/FinancialCondition"
        },
        {
          "$ref": "#/$defs/EventCondition"
        },
        {
          "$ref": "#/$defs/AllCondition"
        },
        {
          "$ref": "#/$defs/AnyCondition"
        },
        {
          "$ref": "#/$defs/NotCondition"
        }
      ]
    },
    "DailyExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "data_capability": {
          "default": "daily_ohlcv",
          "enum": [
            "daily_ohlcv",
            "daily_ohlcv_events",
            "daily_ohlcv_financials",
            "daily_ohlcv_events_financials"
          ],
          "title": "Data Capability",
          "type": "string"
        },
        "entry_policy": {
          "const": "next_tradable_session_open",
          "default": "next_tradable_session_open",
          "title": "Entry Policy",
          "type": "string"
        },
        "evaluation_frequency": {
          "default": "1d_close",
          "enum": [
            "1d_close",
            "event_available_plus_1d_close",
            "financial_available_plus_1d_close",
            "event_financial_available_plus_1d_close"
          ],
          "title": "Evaluation Frequency",
          "type": "string"
        },
        "execution_resolution": {
          "const": "1d",
          "default": "1d",
          "title": "Execution Resolution",
          "type": "string"
        },
        "exit_policy": {
          "const": "next_tradable_session_open",
          "default": "next_tradable_session_open",
          "title": "Exit Policy",
          "type": "string"
        },
        "position_policy": {
          "const": "single_position_no_pyramiding",
          "default": "single_position_no_pyramiding",
          "title": "Position Policy",
          "type": "string"
        },
        "t_plus_one": {
          "const": true,
          "default": true,
          "title": "T Plus One",
          "type": "boolean"
        },
        "timezone": {
          "const": "Asia/Shanghai",
          "default": "Asia/Shanghai",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "DailyExecutionPolicy",
      "type": "object"
    },
    "EventCondition": {
      "additionalProperties": false,
      "description": "A catalog-coded event publication with bounded deterministic filters.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "maxProperties": 8,
          "title": "Attributes",
          "type": "object"
        },
        "definition_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Definition Version",
          "type": "string"
        },
        "document_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventDocumentTextPredicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_code": {
          "pattern": "^event\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Event Code",
          "type": "string"
        },
        "trigger": {
          "const": "published",
          "default": "published",
          "title": "Trigger",
          "type": "string"
        },
        "type": {
          "const": "event_condition",
          "default": "event_condition",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "event_code",
        "definition_version"
      ],
      "title": "EventCondition",
      "type": "object"
    },
    "EventDocumentTextPredicate": {
      "additionalProperties": false,
      "description": "A reproducible term-count predicate bound to the same event document.\n\nThe document extractor and normalization algorithm are part of the frozen\nevent snapshot.  The strategy stores only the deterministic comparison; an\nLLM is never asked to count or summarize the report.",
      "properties": {
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "comparator": {
          "enum": [
            "gt",
            "gte"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "match_mode": {
          "enum": [
            "ascii_token",
            "literal"
          ],
          "title": "Match Mode",
          "type": "string"
        },
        "metric_id": {
          "const": "document.literal_mention_count",
          "default": "document.literal_mention_count",
          "title": "Metric Id",
          "type": "string"
        },
        "metric_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Metric Version",
          "type": "string"
        },
        "normalization": {
          "const": "nfkc",
          "default": "nfkc",
          "title": "Normalization",
          "type": "string"
        },
        "term": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "value": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "term",
        "match_mode",
        "comparator",
        "value"
      ],
      "title": "EventDocumentTextPredicate",
      "type": "object"
    },
    "ExitRule": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllCondition",
          "any": "#/$defs/AnyCondition",
          "event_condition": "#/$defs/EventCondition",
          "financial_condition": "#/$defs/FinancialCondition",
          "holding_period_exit": "#/$defs/HoldingPeriodExit",
          "indicator_condition": "#/$defs/IndicatorCondition",
          "not": "#/$defs/NotCondition",
          "position_return_exit": "#/$defs/PositionReturnExit",
          "trailing_drawdown_exit": "#/$defs/TrailingDrawdownExit"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/IndicatorCondition"
        },
        {
          "$ref": "#/$defs/FinancialCondition"
        },
        {
          "$ref": "#/$defs/EventCondition"
        },
        {
          "$ref": "#/$defs/AllCondition"
        },
        {
          "$ref": "#/$defs/AnyCondition"
        },
        {
          "$ref": "#/$defs/NotCondition"
        },
        {
          "$ref": "#/$defs/HoldingPeriodExit"
        },
        {
          "$ref": "#/$defs/PositionReturnExit"
        },
        {
          "$ref": "#/$defs/TrailingDrawdownExit"
        }
      ]
    },
    "FinancialCondition": {
      "additionalProperties": false,
      "description": "A direct provider financial fact evaluated as known at each bar close.",
      "properties": {
        "comparator": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "ne"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "definition_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Definition Version",
          "type": "string"
        },
        "metric_id": {
          "$ref": "#/$defs/FinancialMetricId"
        },
        "period_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinancialPeriodBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinancialReportType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision_policy": {
          "const": "as_known_at_signal",
          "default": "as_known_at_signal",
          "title": "Revision Policy",
          "type": "string"
        },
        "statement_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinancialStatementScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "financial_condition",
          "default": "financial_condition",
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/FinancialUnit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "comparator",
        "value",
        "unit"
      ],
      "title": "FinancialCondition",
      "type": "object"
    },
    "FinancialMetricId": {
      "description": "The closed first tranche of executable-candidate financial metrics.",
      "enum": [
        "financial.revenue",
        "financial.net_profit_parent",
        "financial.revenue_yoy",
        "financial.net_profit_parent_yoy",
        "financial.roe",
        "financial.gross_margin",
        "financial.net_margin",
        "financial.operating_cash_flow",
        "financial.basic_eps",
        "financial.book_value_per_share",
        "financial.capital_reserve_per_share",
        "financial.unassigned_profit_per_share",
        "financial.operating_cash_flow_per_share",
        "financial.gross_profit",
        "financial.deducted_net_profit",
        "financial.deducted_net_profit_yoy",
        "financial.rota",
        "financial.total_assets_turnover",
        "financial.inventory_turnover",
        "financial.accounts_receivable_turnover",
        "valuation.pe_ttm",
        "valuation.pb_mrq",
        "valuation.dividend_yield_ttm",
        "valuation.pe",
        "valuation.pb",
        "valuation.ps",
        "valuation.pcf"
      ],
      "title": "FinancialMetricId",
      "type": "string"
    },
    "FinancialPeriodBasis": {
      "enum": [
        "single_quarter",
        "ytd_cumulative",
        "full_year",
        "ttm",
        "mrq",
        "point_in_time"
      ],
      "title": "FinancialPeriodBasis",
      "type": "string"
    },
    "FinancialReportType": {
      "enum": [
        "q1",
        "semiannual",
        "q3",
        "annual"
      ],
      "title": "FinancialReportType",
      "type": "string"
    },
    "FinancialStatementScope": {
      "enum": [
        "consolidated",
        "parent_company"
      ],
      "title": "FinancialStatementScope",
      "type": "string"
    },
    "FinancialUnit": {
      "enum": [
        "CNY",
        "CNY_PER_SHARE",
        "PERCENT",
        "RATIO",
        "TIMES"
      ],
      "title": "FinancialUnit",
      "type": "string"
    },
    "FirstOfExit": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/ExitRule"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Children",
          "type": "array"
        },
        "op": {
          "const": "first_of",
          "default": "first_of",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "title": "FirstOfExit",
      "type": "object"
    },
    "HoldingPeriodExit": {
      "additionalProperties": false,
      "description": "Exit at the open of the Nth A-share session after the first entry fill.",
      "properties": {
        "anchor": {
          "const": "first_entry_fill",
          "default": "first_entry_fill",
          "title": "Anchor",
          "type": "string"
        },
        "count_mode": {
          "const": "subsequent_trading_sessions",
          "default": "subsequent_trading_sessions",
          "title": "Count Mode",
          "type": "string"
        },
        "execution": {
          "const": "target_session_open_proxy",
          "default": "target_session_open_proxy",
          "title": "Execution",
          "type": "string"
        },
        "sessions": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Sessions",
          "type": "integer"
        },
        "type": {
          "const": "holding_period_exit",
          "default": "holding_period_exit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sessions"
      ],
      "title": "HoldingPeriodExit",
      "type": "object"
    },
    "IndicatorCondition": {
      "additionalProperties": false,
      "properties": {
        "definition_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Definition Version",
          "type": "string"
        },
        "evaluation_mode": {
          "const": "bar_close_confirmed",
          "default": "bar_close_confirmed",
          "title": "Evaluation Mode",
          "type": "string"
        },
        "indicator_id": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Indicator Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "maxProperties": 16,
          "title": "Params",
          "type": "object"
        },
        "timeframe": {
          "const": "1d",
          "default": "1d",
          "title": "Timeframe",
          "type": "string"
        },
        "trigger": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Trigger",
          "type": "string"
        },
        "type": {
          "const": "indicator_condition",
          "default": "indicator_condition",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "indicator_id",
        "definition_version",
        "trigger"
      ],
      "title": "IndicatorCondition",
      "type": "object"
    },
    "Instrument": {
      "additionalProperties": false,
      "properties": {
        "market": {
          "const": "CN_A",
          "default": "CN_A",
          "title": "Market",
          "type": "string"
        },
        "position_mode": {
          "const": "long_only",
          "default": "long_only",
          "title": "Position Mode",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol"
      ],
      "title": "Instrument",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "NotCondition": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "$ref": "#/$defs/Condition"
        },
        "type": {
          "const": "not",
          "default": "not",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "child"
      ],
      "title": "NotCondition",
      "type": "object"
    },
    "PositionReturnExit": {
      "additionalProperties": false,
      "description": "Exit after a close-confirmed return from the first actual BUY fill.",
      "properties": {
        "anchor": {
          "const": "first_entry_fill",
          "default": "first_entry_fill",
          "title": "Anchor",
          "type": "string"
        },
        "evaluation_mode": {
          "const": "bar_close_confirmed",
          "default": "bar_close_confirmed",
          "title": "Evaluation Mode",
          "type": "string"
        },
        "execution": {
          "const": "next_tradable_session_open",
          "default": "next_tradable_session_open",
          "title": "Execution",
          "type": "string"
        },
        "observation": {
          "const": "back_adjusted_daily_close",
          "default": "back_adjusted_daily_close",
          "title": "Observation",
          "type": "string"
        },
        "threshold_pct": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Threshold Pct",
          "type": "number"
        },
        "trigger": {
          "enum": [
            "take_profit",
            "stop_loss"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "type": {
          "const": "position_return_exit",
          "default": "position_return_exit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "threshold_pct"
      ],
      "title": "PositionReturnExit",
      "type": "object"
    },
    "TrailingDrawdownExit": {
      "additionalProperties": false,
      "description": "Exit after a close-confirmed drawdown from the post-entry close peak.",
      "properties": {
        "anchor": {
          "const": "first_entry_fill",
          "default": "first_entry_fill",
          "title": "Anchor",
          "type": "string"
        },
        "evaluation_mode": {
          "const": "bar_close_confirmed",
          "default": "bar_close_confirmed",
          "title": "Evaluation Mode",
          "type": "string"
        },
        "execution": {
          "const": "next_tradable_session_open",
          "default": "next_tradable_session_open",
          "title": "Execution",
          "type": "string"
        },
        "peak_basis": {
          "const": "back_adjusted_daily_close",
          "default": "back_adjusted_daily_close",
          "title": "Peak Basis",
          "type": "string"
        },
        "threshold_pct": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Threshold Pct",
          "type": "number"
        },
        "type": {
          "const": "trailing_drawdown_exit",
          "default": "trailing_drawdown_exit",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "threshold_pct"
      ],
      "title": "TrailingDrawdownExit",
      "type": "object"
    }
  },
  "$id": "https://schemas.ashare-lab.local/strategy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backtest": {
      "$ref": "#/$defs/BacktestConfig"
    },
    "catalog": {
      "$ref": "#/$defs/CatalogRef"
    },
    "entry": {
      "$ref": "#/$defs/Condition"
    },
    "execution": {
      "$ref": "#/$defs/DailyExecutionPolicy"
    },
    "exit": {
      "$ref": "#/$defs/FirstOfExit"
    },
    "instrument": {
      "$ref": "#/$defs/Instrument"
    },
    "schema_version": {
      "const": "strategy.v1",
      "default": "strategy.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "catalog",
    "instrument",
    "entry",
    "exit",
    "backtest"
  ],
  "title": "StrategySpec",
  "type": "object"
}
