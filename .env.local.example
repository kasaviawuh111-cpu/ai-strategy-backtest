APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite+pysqlite:///./var/ashare.db
INITIALIZE_SCHEMA=true
QUEUE_BACKEND=thread
LOCAL_WORKER_THREADS=1

DATA_ROOT=var/snapshots/composite/replace-with-content-sha256
MARKET_DATA_PROFILE=composite_snapshot
SESSION_REFERENCE_MODE=parquet
SESSION_REFERENCE_PATH=var/snapshots/composite/replace-with-content-sha256/instrument_sessions.parquet
EVENT_DATA_REQUIRED=true
ARTIFACT_ROOT=var/artifacts
CATALOG_ROOT=catalogs
ENGINE_VERSION=2.0.0a0
CORS_ALLOWED_ORIGINS=
